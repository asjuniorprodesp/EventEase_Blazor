@inject EventEaseApiClient ApiClient

<article class="event-card">
    @if (!isEditing)
    {
        <h3>@Event.EventName</h3>
        <p><strong>Data:</strong> @Event.EventDate.ToString("dd/MM/yyyy")</p>
        <p><strong>Local:</strong> @Event.EventLocation</p>
        <p><strong>Descricao:</strong> @Event.EventDescription</p>
    }
    else
    {
        <div class="mb-2">
            <label class="form-label">Nome <span class="text-danger">*</span></label>
            <InputText class="@NameClass" @bind-Value="editName" />
            @if (validationErrors.TryGetValue("nome", out var nomeErr))
            {
                <div class="invalid-feedback d-block">@nomeErr</div>
            }
        </div>

        <div class="mb-2">
            <label class="form-label">Data <span class="text-danger">*</span></label>
            <InputDate TValue="DateOnly" class="@DateClass" @bind-Value="editDate" />
            @if (validationErrors.TryGetValue("data", out var dataErr))
            {
                <div class="invalid-feedback d-block">@dataErr</div>
            }
        </div>

        <div class="mb-2">
            <label class="form-label">Local <span class="text-danger">*</span></label>
            <InputText class="@LocationClass" @bind-Value="editLocation" />
            @if (validationErrors.TryGetValue("local", out var localErr))
            {
                <div class="invalid-feedback d-block">@localErr</div>
            }
        </div>

        <div class="mb-2">
            <label class="form-label">Descricao</label>
            <InputTextArea class="form-control" @bind-Value="editDescription" maxlength="1000" />
            <div class="form-text">@((editDescription ?? "").Length)/1000 caracteres</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="text-danger event-feedback">@errorMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <p class="text-success event-feedback">@successMessage</p>
    }

    <div class="event-card-actions">
        @if (!isEditing)
        {
            <button class="btn btn-outline-secondary" @onclick="StartEdit">Editar evento</button>
            <NavLink class="btn btn-outline-primary" href="@($"/events/{Event.EventId}")">Detalhes</NavLink>
            <NavLink class="btn btn-primary" href="@($"/events/{Event.EventId}/register")">Inscricao</NavLink>
        }
        else
        {
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@isSaving">@(isSaving ? "Salvando..." : "Salvar alteracoes")</button>
            <button class="btn btn-outline-secondary" @onclick="CancelEdit" disabled="@isSaving">Cancelar</button>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public EventItem Event { get; set; } = default!;

    private bool isEditing;
    private bool isSaving;
    private string editName = string.Empty;
    private DateOnly editDate;
    private string editLocation = string.Empty;
    private string? editDescription;
    private string? errorMessage;
    private string? successMessage;
    private Dictionary<string, string> validationErrors = [];

    private static readonly DateOnly MinDate = new(2000, 1, 1);
    private static readonly DateOnly MaxDate = new(2100, 12, 31);

    private string NameClass     => validationErrors.ContainsKey("nome")  ? "form-control is-invalid" : "form-control";
    private string DateClass     => validationErrors.ContainsKey("data")  ? "form-control is-invalid" : "form-control";
    private string LocationClass => validationErrors.ContainsKey("local") ? "form-control is-invalid" : "form-control";

    private void StartEdit()
    {
        errorMessage = null;
        successMessage = null;
        editName = Event.EventName;
        editDate = Event.EventDate;
        editLocation = Event.EventLocation;
        editDescription = Event.EventDescription;
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        errorMessage = null;
        validationErrors.Clear();
    }

    private bool ValidateEditForm()
    {
        validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(editName))
            validationErrors["nome"] = "O nome do evento e obrigatorio.";
        else if (editName.Trim().Length > 200)
            validationErrors["nome"] = "O nome nao pode ultrapassar 200 caracteres.";

        if (editDate == default || editDate < MinDate || editDate > MaxDate)
            validationErrors["data"] = "Informe uma data valida entre 01/01/2000 e 31/12/2100.";

        if (string.IsNullOrWhiteSpace(editLocation))
            validationErrors["local"] = "O local do evento e obrigatorio.";
        else if (editLocation.Trim().Length > 300)
            validationErrors["local"] = "O local nao pode ultrapassar 300 caracteres.";

        return validationErrors.Count == 0;
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (!ValidateEditForm())
            return;

        isSaving = true;

        try
        {
            var updated = new EventItem
            {
                EventId = Event.EventId,
                EventName = editName.Trim(),
                EventDate = editDate,
                EventLocation = editLocation.Trim(),
                EventDescription = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim(),
                CreatedAt = Event.CreatedAt
            };

            await ApiClient.UpdateEventAsync(updated);

            Event.EventName = updated.EventName;
            Event.EventDate = updated.EventDate;
            Event.EventLocation = updated.EventLocation;
            Event.EventDescription = updated.EventDescription;

            successMessage = "Evento atualizado com sucesso.";
            isEditing = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
