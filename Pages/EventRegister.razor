@page "/events/{Id:int}/register"
@inject EventEaseApiClient ApiClient
@inject IJSRuntime JS
@using System.ComponentModel.DataAnnotations

<PageTitle>Inscricao</PageTitle>

@if (isLoading)
{
    <p>Carregando evento...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}
else if (eventItem is null)
{
    <p>Evento nao encontrado.</p>
}
else
{
    <h1>Inscricao em @eventItem.EventName</h1>
    <p><strong>Data:</strong> @eventItem.EventDate.ToString("dd/MM/yyyy")</p>
    <p><strong>Local:</strong> @eventItem.EventLocation</p>

    <EditForm Model="form" OnValidSubmit="SubmitAsync" class="register-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="fullName">Nome completo</label>
            <input id="fullName" class="form-control" @bind="form.FullName" @bind:event="oninput" @bind:after="PersistDraftAsync" />
            <ValidationMessage For="() => form.FullName" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="email">E-mail</label>
            <input id="email" type="email" class="form-control" @bind="form.Email" @bind:event="oninput" @bind:after="PersistDraftAsync" />
            <ValidationMessage For="() => form.Email" />
        </div>

        <div class="event-card-actions">
            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">@(isSubmitting ? "Enviando..." : "Confirmar inscricao")</button>
            <NavLink class="btn btn-outline-primary" href="@($"/events/{Id}")">Voltar aos detalhes</NavLink>
        </div>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <p class="text-success mt-3">@successMessage</p>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EventItem? eventItem;
    private readonly RegistrationForm form = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;
    private string? successMessage;

    private string DraftKey => $"eventease.register.draft.{Id}";
    private const string ProfileKey = "eventease.register.profile";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            eventItem = await ApiClient.GetEventByIdAsync(Id);
            await RestoreSessionStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar evento: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;
        successMessage = null;
        isSubmitting = true;

        try
        {
            await ApiClient.RegisterAsync(Id, form.FullName, form.Email);
            successMessage = "Inscricao realizada com sucesso.";
            await JS.InvokeVoidAsync("eventEaseSession.set", ProfileKey, form);
            await JS.InvokeVoidAsync("eventEaseSession.remove", DraftKey);
        }
        catch (Exception ex)
        {
            errorMessage = $"Falha ao registrar inscricao: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task PersistDraftAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eventEaseSession.set", DraftKey, form);
        }
        catch
        {
            // Draft persistence is best effort only.
        }
    }

    private async Task RestoreSessionStateAsync()
    {
        try
        {
            var draft = await JS.InvokeAsync<RegistrationForm?>("eventEaseSession.get", DraftKey);
            if (draft is not null)
            {
                form.FullName = draft.FullName;
                form.Email = draft.Email;
                return;
            }

            var profile = await JS.InvokeAsync<RegistrationForm?>("eventEaseSession.get", ProfileKey);
            if (profile is not null)
            {
                form.FullName = profile.FullName;
                form.Email = profile.Email;
            }
        }
        catch
        {
            // Storage access can fail in hardened browser modes.
        }
    }

    private class RegistrationForm
    {
        [Required(ErrorMessage = "Nome completo e obrigatorio.")]
        [StringLength(120, MinimumLength = 3, ErrorMessage = "Nome deve ter entre 3 e 120 caracteres.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "E-mail e obrigatorio.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail valido.")]
        [StringLength(160, ErrorMessage = "E-mail muito longo.")]
        public string Email { get; set; } = string.Empty;
    }
}
